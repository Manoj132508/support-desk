# For `docker compose` (Phase 15). Copy to `.env` beside docker-compose.yml and
# fill in. `.env` is gitignored and must never be committed.
#
# This is NOT the development file. `.env.example` documents `server/.env` for
# `npm run dev`, where the services find each other on localhost. Here they are
# containers on their own network, so the addresses differ and compose sets
# them itself.
#
# NAMES ONLY -- never a value for a secret here. server/test/noSecrets.test.js
# scans this file and fails if a secret setting below has one.

# ── Secrets, required ─────────────────────────────────────────────────────
# At least 32 characters each; compose refuses to start without them, and so
# does each service in production. One way to make one:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=
AI_SERVICE_TOKEN=

# ── The deployment ────────────────────────────────────────────────────────
# `production` marks the session cookie Secure, and a browser will not send a
# Secure cookie over plain http -- so signing in at http://localhost fails.
# Serve it behind HTTPS, or set `development` for a local trial (DEPLOYMENT.md).
NODE_ENV=production
CLIENT_PORT=5179

# ── The model, on the host ────────────────────────────────────────────────
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=llama3.1:8b
# Leave empty to let Ollama decide; 0 keeps the model entirely on the CPU.
AI_NUM_GPU=
