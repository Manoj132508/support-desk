# Copy to .env and fill in. .env is gitignored and must never be committed.
# This file documents the NAMES only -- never put a real value here.

# ── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas free tier (M0). Atlas clusters are replica sets by default,
# which this project REQUIRES: execution commits the order update, the
# ActionOutcome insert and the TicketEvent insert in one multi-document
# transaction (Phase 3 section 9), and a standalone mongod cannot do that.
#
# Local fallback, if you would rather not use Atlas -- note it must still be a
# replica set, not the default standalone install:
#   mongod --replSet rs0 --dbpath <path>
#   then once, in mongosh:  rs.initiate()
#   MONGODB_URI=mongodb://127.0.0.1:27017/ai-support-desk?replicaSet=rs0
MONGODB_URI=

# ── API (Phase 6 onward) ──────────────────────────────────────────────────
PORT=4400
NODE_ENV=development
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5179

# ── AI service ────────────────────────────────────────────────────────────
# Not publicly routable. Express is the only thing that calls it, and it holds
# no database credential at all -- that is ADR 0002, not an oversight.
AI_SERVICE_URL=http://localhost:8200

# Shared secret so the advisory tier declines calls that did not come from the
# API tier. Defence in depth: the real protection is that it is not routable,
# but "not routable" is a deployment property and those get changed in a hurry.
# Set the SAME value as AI_SERVICE_TOKEN below on both sides.
AI_SERVICE_TOKEN=

# ── AI service's own settings (prefix AI_, read by pydantic-settings) ─────
AI_SERVICE_TOKEN=
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3.1:8b
AI_SCORE_THRESHOLD=0.35
AI_KB_PATH=data/kb
AI_INDEX_PATH=data/index
