# Copy to .env and fill in. .env is gitignored and must never be committed.
# This file documents the NAMES only -- never put a real value here. A test
# (server/test/noSecrets.test.js) fails if a secret setting below has a value.

# ── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas free tier (M0). Atlas clusters are replica sets by default,
# which this project REQUIRES: execution commits the order update, the
# ActionOutcome insert and the TicketEvent insert in one multi-document
# transaction (Phase 3 section 9), and a standalone mongod cannot do that.
#
# Local fallback, if you would rather not use Atlas -- note it must still be a
# replica set, not the default standalone install:
#   mongod --replSet rs0 --dbpath <path>
#   then once, in mongosh:  rs.initiate()
#   MONGODB_URI=mongodb://127.0.0.1:27017/ai-support-desk?replicaSet=rs0
MONGODB_URI=

# ── API ───────────────────────────────────────────────────────────────────
PORT=4400
NODE_ENV=development
# In production the API refuses to start unless this is at least 32 characters.
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5179

# ── Both tiers ────────────────────────────────────────────────────────────
# Shared secret so the AI service declines calls that did not come from the
# API. Defence in depth: the real protection is that the AI service is not
# routable, but "not routable" is a deployment property and those get changed
# in a hurry. ONE variable, read by both tiers: the API sends it, and the AI
# service (whose settings take the AI_ prefix) reads the same name. In
# production both tiers refuse to start without it, at least 32 characters.
AI_SERVICE_TOKEN=

# ── AI service ────────────────────────────────────────────────────────────
# Not publicly routable. Express is the only thing that calls it, and it holds
# no database credential at all -- that is ADR 0002, not an oversight.
AI_SERVICE_URL=http://localhost:8200
AI_ENVIRONMENT=development
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3.1:8b
# Model layers Ollama may put on a GPU. Leave empty to let Ollama decide; 0 runs
# the model on the CPU only, as the development machine must.
AI_NUM_GPU=
AI_SCORE_THRESHOLD=0.51
AI_KB_PATH=data/kb
AI_INDEX_PATH=data/index
